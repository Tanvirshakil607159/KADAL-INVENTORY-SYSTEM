{
  "name": "kadal-inventory",
  "version": "1.1.98",
  "description": "KADAL - Inventory Management System for KA Design Accessories LTD",
  "main": "src/main/index.js",
  "author": "KA Design Accessories LTD",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "build:web": "node scripts/generate-config.js && vite build --base /",
    "dist": "npm run build && electron-builder && node scripts/copy-installer.js",
    "release": "npm run build && electron-builder --publish always && node scripts/copy-installer.js"
  },
  "dependencies": {
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@supabase/supabase-js": "^2.105.4",
    "@xmldom/xmldom": "^0.9.10",
    "app-builder-bin": "^5.0.0-alpha.10",
    "bcryptjs": "^2.4.3",
    "call-bind": "^1.0.9",
    "call-bind-apply-helpers": "^1.0.2",
    "call-bound": "^1.0.4",
    "date-fns": "^4.1.0",
    "deep-equal": "^1.1.2",
    "dunder-proto": "^1.0.1",
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "get-intrinsic": "^1.3.0",
    "get-proto": "^1.0.1",
    "is-arguments": "^1.2.0",
    "jsbarcode": "^3.12.3",
    "object-is": "^1.1.6",
    "pdfmake": "^0.2.15",
    "qrcode": "^1.5.4",
    "sql.js": "^1.11.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "com.kadesign.kadal",
    "productName": "KADAL Inventory",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "dist/**/*",
      "node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "icon": "assets/logo.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "Tanvirshakil607159",
      "repo": "KADAL-INVENTORY-SYSTEM",
      "releaseType": "release"
    }
  }
}